# Токен бота от @BotFather
BOT_TOKEN=

# Токен приложения из @CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=

# Тестовая сеть (через @CryptoTestnetBot): https://testnet-pay.crypt.bot/api
# Боевая сеть (через @CryptoBot):          https://pay.crypt.bot/api
CRYPTO_PAY_BASE_URL=https://testnet-pay.crypt.bot/api

# В каком активе указывать цены (USDT, TON, BTC, ...)
CRYPTO_ASSET=USDT

# Публичная HTTPS-ссылка на саму витрину (например GitHub Pages/Vercel,
# либо тот же адрес сервера + /gift-market.html, если раздаёшь статику отсюда же)
WEBAPP_URL=https://your-domain.example/gift-market.html

# Порт, на котором слушает express
PORT=3000
